#!/bin/sh
##
##

### BEGIN INIT INFO
# Provides:          piler
# Required-Start:    $remote_fs $syslog $named $network $time mysql
# Required-Stop:     $remote_fs $syslog $named $network mysql
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: piler email archiver
# Description:       piler email archiver
### END INIT INFO


NAME=piler
OPTIONS=""
PID_FILE="$(SBINDIR/pilerconf $OPTIONS -q pidfile | cut -f2 -d=)"
PID_NUMBER="$(test -f "$PID_FILE" && cat "$PID_FILE")"
PILER_SMTP_PID="$(pgrep piler-smtp)"
WORK_DIR="$(SBINDIR/pilerconf $OPTIONS -q workdir | cut -f2 -d=)"
STOP_DRAIN_TIMEOUT="${PILER_STOP_DRAIN_TIMEOUT:-300}"
STOP_DRAIN_INTERVAL="${PILER_STOP_DRAIN_INTERVAL:-2}"
STOP_DRAIN_ENABLED="${PILER_STOP_DRAIN:-1}"

spool_count() {
   find "${WORK_DIR:-/var/piler/tmp}" -type f 2>/dev/null | wc -l
}

start() {
   echo "starting piler-smtp . . . "
   SBINDIR/piler-smtp -d

   echo "starting $NAME . . ."
   SBINDIR/piler -d $OPTIONS
}

stop() {
   if [ "$STOP_DRAIN_ENABLED" = "1" ]; then drain_stop "$STOP_DRAIN_TIMEOUT"; return; fi

   if [ "$PID_NUMBER" != "" ]; then echo "stopping piler"; kill "$PID_NUMBER"; fi

   if [ "$PILER_SMTP_PID" != "" ]; then echo "stopping piler-smtp"; kill "$PILER_SMTP_PID"; fi
}

force_stop() {
   if [ "$PID_NUMBER" != "" ]; then echo "stopping piler"; kill "$PID_NUMBER"; fi

   if [ "$PILER_SMTP_PID" != "" ]; then echo "stopping piler-smtp"; kill "$PILER_SMTP_PID"; fi
}

drain_stop() {
   timeout="${1:-$STOP_DRAIN_TIMEOUT}"
   elapsed=0

   if [ "$PILER_SMTP_PID" != "" ]; then
      echo "stopping piler-smtp"
      kill "$PILER_SMTP_PID"
   fi

   initial_count="$(spool_count)"
   echo "piler backlog drain started: initial_files=${initial_count}, timeout=${timeout}s"

   while [ "$(spool_count)" -gt 0 ] && [ "$elapsed" -lt "$timeout" ]; do
      if [ "$PID_NUMBER" = "" ] || [ ! -f "/proc/${PID_NUMBER}/status" ]; then
         break
      fi

      echo "waiting for piler backlog to drain: $(spool_count) files remaining"
      sleep "$STOP_DRAIN_INTERVAL"
      elapsed=$((elapsed + STOP_DRAIN_INTERVAL))
   done

   remaining_count="$(spool_count)"
   echo "piler backlog drain finished: initial_files=${initial_count}, remaining_files=${remaining_count}, elapsed=${elapsed}s"

   if [ "$remaining_count" -gt 0 ]; then
      echo "piler backlog still has ${remaining_count} files after ${elapsed}s, stopping anyway"
   else
      echo "piler backlog drained"
   fi

   if [ "$PID_NUMBER" != "" ]; then echo "stopping piler"; kill "$PID_NUMBER"; fi
}

check_status(){
        if [ -f "/proc/${PID_NUMBER}/status" ]; then
           echo "piler is running, pid: ${PID_NUMBER}";
        else
           echo "piler is NOT running";
        fi

        if [ "${PILER_SMTP_PID}" != '' ]; then
           echo "piler-smtp is running, pid: ${PILER_SMTP_PID}";
        else
           echo "piler-smtp is NOT running";
        fi
}

case "$1" in
        start)
                start;
        ;;

        stop)
                stop;
        ;;

        force-stop)
                force_stop;
        ;;

        drain-stop)
                drain_stop "${2:-$STOP_DRAIN_TIMEOUT}";
        ;;

        status)
                if check_status; then
                   exit 0
                else
                   exit 1
                fi
        ;;

        restart)
                stop;
                sleep 1;
                start;
        ;;

        reload)
                kill -HUP "$PID_NUMBER"
                echo "reloaded"
        ;;

        *)
                echo "Usage: $0 start|stop|force-stop|drain-stop|restart|reload|status"
        ;;
esac
